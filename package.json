{
  "name": "idle-tribe",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot index.html",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json",
    "build": "bun run typecheck && bun run build.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "balance": "bun scripts/simulate-visits.ts",
    "check": "bun run lint && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/themes": "^3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
