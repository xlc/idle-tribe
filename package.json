{
  "name": "idle-tribe",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot index.html",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun run build.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "test": "bun test ./src",
    "test:browser": "playwright test",
    "balance": "bun scripts/simulate-visits.ts",
    "check": "bun run lint && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "daisyui": "5.7.50",
    "lightningcss": "1.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
